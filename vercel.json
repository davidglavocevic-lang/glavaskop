{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/organizer" },
    { "source": "/admin/login", "destination": "/admin-login" },
    { "source": "/admin/web", "destination": "/organizer" },
    { "source": "/admin/web/:path*", "destination": "/organizer" },
    { "source": "/admin/organizer", "destination": "/organizer" },
    { "source": "/admin/organizer/:path*", "destination": "/organizer" }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 6 * * *"
    }
  ]
}
